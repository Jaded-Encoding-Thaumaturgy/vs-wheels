  "settings": {
    "editor.formatOnSave": true,
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.tabSize": 2,
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
      "editor.tabSize": 2,
    },
    "[toml]": {
      "editor.defaultFormatter": "tamasfe.even-better-toml",
      "editor.tabSize": 4,
    },
    "[github-actions-workflow]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
      "editor.tabSize": 2,
    },
    "[powershell]": {
      "debug.saveBeforeStart": "nonUntitledEditorsInActiveGroup",
      "editor.semanticHighlighting.enabled": false,
      "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
      "editor.defaultFormatter": "ms-vscode.powershell",
    },
    "cmake.sourceDirectory": "${workspaceFolder}",
    "powershell.cwd": "vs-wheels (Root)",
    "yaml.schemas": {
      "https://www.schemastore.org/github-action.json": "**/.github/actions/**/*.yml",
    },
    "files.associations": {
      "**/.github/workflows/*.yml": "github-actions-workflow",
      "**/.github/actions/**/action.yml": "github-actions-workflow",
    },
    "cmake.automaticReconfigure": false,
    "cmake.autoSelectActiveFolder": false,
    "cmake.buildBeforeRun": false,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.ignoreCMakeListsMissing": true,
    "mesonbuild.selectRootDir": false,
  },
  "extensions": {
    "recommendations": [
      "skellock.just",
      "tamasfe.even-better-toml",
      "oxc.oxc-vscode",
      "ms-vscode.cmake-tools",
      "ms-python.python",
      "charliermarsh.ruff",
      "ms-vscode.powershell",
    ],
  },
}
